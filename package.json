    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "9.1.7",
    "prettier": "^3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "8.3.3",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
