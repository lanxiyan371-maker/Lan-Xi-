    "prepare": "husky",
    "party:dev": "wrangler dev",
    "party:deploy": "wrangler deploy"
  },
  "dependencies": {
    "partyserver": "^0.5.8",
    "partysocket": "^1.3.0",
    "react": "^19.2.7",
